#!/usr/bin/env bash

set -e -o pipefail

. "$(dirname "$0")/tools/common.sh"


function install_packages()
{
	local system
	system="$(get_build_machine_type)"
	system=${system%%-*}

	local packages="wget"
	case $system in
		linux)
			sudo apt-get update
			sudo apt-get install -y --no-install-recommends $packages
		;;
		macos)
			packages="${packages} bash"
			brew update
			brew install --quiet $packages
		;;
	esac
}


DEST_DIR=$1
if [ -z "$DEST_DIR" ]; then
	DEST_DIR="source-tarballs"
fi

mkdir -p "$DEST_DIR"
if [ ! -d "$DEST_DIR" ]; then
	echo "[ERROR] Directory not found ($DEST_DIR)" >&2
	exit 1
fi

install_packages

download_package "$DEST_DIR" "$(get_mirrors "linux" "$LINUX_VER")" \
	"linux-${LINUX_VER}.tar.xz" "$LINUX_SHA256" "kernel headers ${LINUX_VER}"
download_package "$DEST_DIR" "$MUSL_URL" \
	"musl-${MUSL_VER}.tar.gz" "$MUSL_SHA256" "musl ${MUSL_VER}"

exit 0
